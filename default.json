{
  "extends": [
    // we use the full `config:best-practices` preset
    // but we use `pinGitHubActionDigestsToSemver` to have more accurate updates tracking
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
    // to massively reduce noise, we only get 2 PRs: update all non-major deps + lockfile maintenance
    "group:allNonMajor",
    // sets rangeStrategy to replace globally, overridden by package rules
    ":preserveSemverRanges",
    ":prHourlyLimitNone",
    // run once a week to reduce noise. Every monday we deal with renovate and forget about it for the rest of the week
    "schedule:weekly"
  ],
  "timezone": "UTC",
  // setting it to any other value made renovate update already open PRs even outside schedule
  "recreateWhen": "never",
  // we update the constraint when our global minimum python changes
  "constraints": {
    "python": ">=3.12,<3.13"
  },
  // absolutely no activity outside of schedule, unless we manually trigger it or it's a security update
  "updateNotScheduled": false,
  // supply chain security, note that it must also be configured in each package manager using their own implementations to the same value
  "minimumReleaseAge": "7 days",
  // useful table of changed dependencies in renovate commits
  "commitBodyTable": true,
  // as per our labels convention
  "labels": ["type: chore"],
  // security updates bypass any schedules
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["type: security"]
  },
  "osvVulnerabilityAlerts": true,
  // pre-commit is not enabled by default in renovate
  "pre-commit": {
    "enabled": true
  },
  // we might explore it in the future, explicitly disabling it for now
  "semanticCommits": "disabled",
  // technically it is the default, but just to be sure
  "internalChecksFilter": "strict",
  // those are too noisy
  "suppressNotifications": ["prEditedNotification"],
  "packageRules": [
    {
      "description": "We set only the lower bound for python deps, so we want to update lockfile and still see changelogs",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "An upper bound on a python dep is deliberate, so an update past it waits for approval in its own PR instead of widening the range in the group",
      "matchManagers": ["pep621"],
      "matchCurrentValue": "/</",
      "matchJsonata": ["newValue != currentValue"],
      "dependencyDashboardApproval": true,
      "groupName": null
    },
    {
      "description": "Python images follow constraints.python, which only applies to package managers, so both move together when our global minimum python changes",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    },
    {
      "description": "Our images are rebuilt on every release to pick up base image fixes",
      "matchFileNames": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"
      ],
      "pinDigests": false
    },
    {
      "description": "Stay on nginx stable releases, which have an even minor version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "allowedVersions": "/^\\d+\\.\\d*[02468](\\.\\d+)?(-.+)?$/"
    },
    {
      "description": "Lockfile maintenance doesn't support minimumReleaseAge, but our package managers validate it themselves",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "uv lock --upgrade also takes in-range releases of direct deps, majors pending approval included, so we approve it right after merging the non-major PR",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "pinDigest doesn't change a version, so no validation is needed",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    // https://github.com/renovatebot/renovate/issues/38656
    // https://github.com/renovatebot/renovate/issues/38659
    {
      "description": "digest doesn't support minimumReleaseAge yet for docker",
      "matchUpdateTypes": ["digest"],
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    },
    // this rule is used to override `security:minimumReleaseAgeNpm` default of 3 days
    {
      "description": "All npm package updates must wait for 7 days to align with pnpm minimumReleaseAge",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Skip minimum release age for cutting edge tools we deliberately use and update often",
      "matchDatasources": ["npm"],
      "matchPackageNames": [
        "oxfmt",
        "oxlint",
        "oxfmt-*",
        "oxlint-*",
        "@base-ui/*"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip minimum release age for packages we release, same as exclude-newer-package in uv",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["bitcart", "tronpy", "trontxsize", "universalasync"],
      "minimumReleaseAge": null
    },
    {
      "description": "The package is not abandoned, but feature-complete",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["class-variance-authority"],
      "abandonmentThreshold": null
    },
    {
      "description": "The packages are not abandoned, but feature-complete",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["jinja2", "pyotp"],
      "abandonmentThreshold": null
    },
    {
      "description": "ShellCheck is actively developed, but only releases every year or two",
      "matchPackageNames": ["koalaman/shellcheck", "koalaman/shellcheck-precommit"],
      "abandonmentThreshold": null
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Disable major updates for dependency overrides",
      "matchDepTypes": [
        "pnpm-workspace.overrides",
        "pnpm.overrides",
        "overrides",
        "resolutions"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Require approval for go cli package as it updates too often",
      "matchDatasources": ["go"],
      "matchPackageNames": ["github.com/urfave/cli/v2"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group prettier packages on major bumps",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["prettier", "@prettier/*", "prettier-plugin-*"],
      "matchUpdateTypes": ["major"],
      "groupName": "prettier packages"
    },
    {
      "description": "Group all OpenTelemetry python packages from both upstream monorepos",
      "extends": [
        "monorepo:opentelemetry-python",
        "monorepo:opentelemetry-python-contrib"
      ],
      "groupName": "opentelemetry packages",
      // opentelemetry-distro and others are classified as "major" while e.g. sdk as "minor"
      "separateMajorMinor": false,
      // opentelemetry-distro/-instrumentation ship as pep440 pre-releases
      "ignoreUnstable": false
    },
    {
      "description": "Forgejo doesn't support actions/download-artifact and actions/upload-artifact above v3",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".forgejo/**"],
      "matchPackageNames": [
        "actions/download-artifact",
        "actions/upload-artifact"
      ],
      "allowedVersions": "<4"
    },
    {
      "description": "Don't pin our reusable bitcart/bitcart-actions for ease of propagation across all repositories",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["bitcart/bitcart-actions"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions in workflows and composite actions, pinned as a quoted `KEY: \"version\"` under a `# renovate:` comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.(?:github|forgejo)/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Za-z0-9_-]+: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Docker images in workflow expressions and scripts, pinned as a single-quoted `'image:tag@digest'` under a `# renovate:` comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.(?:github|forgejo)/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n[^\\n]*'[^:'\\n]+:[^'@\\n]+(?:@sha256:[a-f0-9]{64})?'",
        "'[^:'\\n]+:(?<currentValue>[^'@\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?'"
      ],
      "autoReplaceStringTemplate": "'{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}'"
    },
    {
      "description": "Tool versions in Dockerfiles, set as `ENV KEY=version` or `ARG KEY=version` under a `# renovate:` comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n(?:ENV|ARG) [A-Za-z0-9_]+=(?<currentValue>[^\\s\"]+)"
      ]
    }
  ],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"]
}
